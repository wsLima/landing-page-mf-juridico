# Copie este arquivo para .env.local e preencha.

# Número do WhatsApp do escritório, com DDI e DDD (somente dígitos). Padrão: (92) 98236-3086
VITE_WHATSAPP_NUMBER=5592982363086

# Supabase (banco de dados da área administrativa). Em: painel do projeto › Project Settings › API.
# Sem estas duas linhas, o site usa dados de demonstração e o painel não salva nada.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Analytics 4 (opcional). Em: Administrador › Fluxos de dados › Web › ID da métrica (G-XXXXXXXXXX).
# Sem este valor, o site não carrega o Analytics nem mostra o aviso de cookies.
VITE_GA_MEASUREMENT_ID=
